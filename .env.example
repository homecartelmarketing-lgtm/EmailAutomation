# ---------------------------------------------------------------------------
# HomeCartel Email Automation — environment template
# Copy to .env and fill in real values. src/config.js is the source of truth.
# ---------------------------------------------------------------------------

# Server
PORT=3000
SHOP_DOMAIN=homecartel.net
DB_PATH=./data/homecartel.db

# Public base URL used for unsubscribe links and email header images.
# Leave blank on Railway to derive from RAILWAY_PUBLIC_DOMAIN automatically.
APP_BASE_URL=

# Shopify Webhooks (REQUIRED — server throws at boot if missing)
# Must be the same signing secret configured on every Shopify webhook.
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Email Provider (mock | resend)
# mock = in-memory, no network calls (default, safe for local dev/tests)
EMAIL_PROVIDER=mock
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=HomeCartel <support@homecartel.net>

# Master killswitch for the background scheduler.
# Must be exactly the lowercase string "true" to enable automatic dispatch.
# While false/unset, jobs are still queued but nothing is sent automatically.
# Leave unset until you are ready to send real email.
ENABLE_AUTO_DISPATCH=false
